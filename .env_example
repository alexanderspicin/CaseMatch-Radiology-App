# Database Configuration
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=casematch
DB_HOST=db
DB_PORT=5432

# Security
SECRET_KEY=your_secret_key_min_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# PgAdmin Configuration
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# Docker Environment
DOCKER_ENV=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ML Model Configuration
MODEL_PATH=/app/models/advanced_v3_all_in_one_smooth.h5
MODEL_THRESHOLD=0.5

# Streamlit Configuration (for streamlit service)
API_URL=http://nginx

# Monitoring (for production)
GRAFANA_PASSWORD=admin
PROMETHEUS_RETENTION=30d

# Scaling Configuration
API_REPLICAS=3
STREAMLIT_REPLICAS=2

# Backup Configuration
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=7

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS Configuration
CORS_ORIGINS=http://localhost,http://localhost:8501,http://localhost:80